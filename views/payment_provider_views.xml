<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Plutu Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <field
                    string="API Key"
                    name="plutu_api_key"
                    invisible="code != 'plutu'"
                    required="is_live"
                />
                <field
                    string="Access Token"
                    name="plutu_access_token"
                    invisible="code != 'plutu'"
                    required="is_live"
                    widget="password"
                />
                <field
                    string="Secret Key"
                    name="plutu_secret_key"
                    invisible="code != 'plutu'"
                    required="is_live"
                    widget="password"
                />
            </group>
        </field>
    </record>

</odoo>
